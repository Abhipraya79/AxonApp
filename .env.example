# ============================================================
# AxonApp Frontend Environment Template
# Copy this file to .env atau .env.local
# ============================================================

# ── Mode koneksi API ─────────────────────────────────────────
# false → Direct URL ke VITE_API_BASE_URL (bypass Vite proxy, default)
# true  → Lewat Vite proxy /api (jika Direct diblokir CORS di environment tertentu)
VITE_USE_PROXY=false

# ── Backend URL ───────────────────────────────────────────────
VITE_API_BASE_URL=https://axonbe.bgsprayogi.my.id
